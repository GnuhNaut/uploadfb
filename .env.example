# Telegram Settings (via my.telegram.org)
TG_API_ID=your_api_id
TG_API_HASH=your_api_hash
TG_SESSION=
TG_MONITOR_CHANNELS=channel1,channel2

# Telegram Alert Bot (for error alerting)
TG_ALERT_BOT_TOKEN=your_bot_token
TG_ALERT_CHAT_ID=your_chat_id

# Facebook Settings
# MODE can be 'api' (for Pages) or 'playwright' (for Groups/Profiles)
FB_MODE=api
FB_PAGE_ACCESS_TOKEN=your_page_access_token
FB_PAGE_ID=your_page_id
FB_EMAIL=your_facebook_email
FB_PASSWORD=your_facebook_password

# Limits
RATE_LIMIT_POSTS_PER_HOUR=5
